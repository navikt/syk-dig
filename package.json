{
    "name": "syk-dig",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "yarn@4.18.1",
    "engines": {
        "node": "24"
    },
    "scripts": {
        "dev": "concurrently --names 'next,gen'  --prefix-colors 'blue,magenta' 'yarn dev:next' 'yarn gen:watch'",
        "dev:next": "next dev | pino-pretty --messageKey=message",
        "start:e2e": "NEXT_PUBLIC_ASSET_PREFIX= node .next/standalone/server.js | pino-pretty --messageKey=message",
        "build": "./scripts/pre-build.sh && next build",
        "build:e2e": "./scripts/build-e2e.sh",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "test": "vitest --config vitest.config.mts",
        "e2e": "playwright test",
        "e2e:dev": "yarn e2e --ui",
        "e2e:fast": "FAST=true yarn e2e --ui",
        "gen": "graphql-codegen",
        "gen:watch": "graphql-codegen --watch",
        "pull-schema": "wget https://syk-dig-backend.intern.dev.nav.no/schema.json -O ./schema.json && oxfmt schema.json",
        "update-schema": "yarn pull-schema && yarn gen",
        "prepare": "husky"
    },
    "dependencies": {
        "@apollo/client": "^4.3.5",
        "@graphql-tools/schema": "^11.0.7",
        "@graphql-typed-document-node/core": "^3.2.0",
        "@hookform/error-message": "^2.0.1",
        "@navikt/aksel-icons": "^8.20.1",
        "@navikt/ds-css": "^8.20.1",
        "@navikt/ds-react": "^8.20.1",
        "@navikt/next-api-proxy": "^5.0.5",
        "@navikt/next-logger": "^5.0.1",
        "@navikt/oasis": "^4.2.2",
        "@navikt/tsm-diagnoser": "^2026.8.25",
        "@unleash/nextjs": "^1.6.7",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "fuse.js": "^7.5.0",
        "graphql": "^16.14.2",
        "graphql-yoga": "^5.24.6",
        "next": "16.4.3",
        "next-logger": "^5.0.2",
        "nextleton": "^0.6.1",
        "node-cache": "^5.1.2",
        "pdfobject": "^2.3.1",
        "pino": "^10.4.0",
        "pino-pretty": "^13.2.0",
        "prom-client": "^15.1.3",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-hook-form": "^7.91.0",
        "react-resizable-panels": "^4.15.0",
        "remeda": "^2.54.1",
        "rxjs": "^7.8.2",
        "swr": "^2.5.1",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@graphql-codegen/add": "^7.1.1",
        "@graphql-codegen/cli": "^7.4.6",
        "@graphql-codegen/fragment-matcher": "^7.1.1",
        "@graphql-codegen/typed-document-node": "^7.2.0",
        "@graphql-codegen/typescript-operations": "^6.2.0",
        "@graphql-codegen/typescript-resolvers": "^6.1.1",
        "@hookform/devtools": "^4.4.0",
        "@navikt/ds-tailwind": "^8.20.1",
        "@navikt/tsm-oxfmt": "^0.0.11",
        "@navikt/tsm-oxlint": "^0.0.7",
        "@parcel/watcher": "^2.6.0",
        "@playwright/test": "1.64.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "24.19.2",
        "@types/pdfobject": "^2.2.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.6",
        "dotenv": "^18.0.9",
        "graphql-sock": "^1.0.1",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.6.0",
        "next-router-mock": "^1.0.5",
        "nock": "^15.0.5",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "oxlint-tsgolint": "^7.0.2005",
        "postcss": "^8.5.31",
        "tailwindcss": "^4.3.3",
        "typescript": "7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "vitest-dom": "^0.1.1"
    }
}
